---
import '../styles/global.css';import Header from '../components/Header.astro';import Footer from '../components/Footer.astro';import type {Locale} from '../data/site';
interface Props{locale:Locale;title:string;description?:string;image?:string} const {locale,title,description='UNMTD1 — Women shaping music, one story at a time.',image}=Astro.props;
---
<html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{title} — UNMTD1</title><meta name="description" content={description}/><meta name="theme-color" content="#11110f"/><meta property="og:title" content={`${title} — UNMTD1`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:image" content={image?new URL(import.meta.env.BASE_URL.replace(/\/$/,'')+image,Astro.site):new URL(import.meta.env.BASE_URL+'og-default.svg',Astro.site)}/><meta name="twitter:card" content="summary_large_image"/><link rel="icon" href={import.meta.env.BASE_URL+'favicon.svg'}/><link rel="alternate" type="application/rss+xml" href={import.meta.env.BASE_URL+'rss.xml'}/></head><body><a class="skip" href="#main">Skip to content</a><Header locale={locale}/><main id="main"><slot/></main><Footer locale={locale}/></body></html>
