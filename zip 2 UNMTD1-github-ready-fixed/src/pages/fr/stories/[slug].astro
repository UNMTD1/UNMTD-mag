---
import BaseLayout from '../../../layouts/BaseLayout.astro';import Media from '../../../components/Media.astro';import {getCollection,render} from 'astro:content';import {getEpisodes,episodePath,personPath,formatDate} from '../../../utils/content';export async function getStaticPaths(){return (await getCollection('episodes',({data})=>!data.draft)).map(entry=>({params:{slug:entry.id.replace(/\.md$/,'')},props:{entry}}))};const{entry}=Astro.props;const{Content}=await render(entry);const people=await getCollection('people');const person=people.find(x=>x.id===entry.data.person);const all=await getEpisodes();const i=all.findIndex(x=>x.id===entry.id);const prev=all[i+1],next=all[i-1];
---
<BaseLayout locale="fr" title={entry.data.title.fr} description={entry.data.excerpt.fr} image={entry.data.image}><section class="article-head"><div class="container article"><div class="eyebrow">{entry.data.series} · EPISODE {String(entry.data.episode).padStart(2,'0')}</div><h1 class="display">{entry.data.title.fr}</h1><div class="article-meta"><span>{formatDate(entry.data.date,'fr')}</span><span>{entry.data.type}</span></div>{entry.data.image&&<img class="article-hero" src={entry.data.image} alt={entry.data.imageAlt?.fr||''}/>}<p class="lead">{entry.data.excerpt.fr}</p></div></section><section class="section"><div class="container article article-content"><Content/><Media locale="fr" video={entry.data.video} audio={entry.data.audio}/>{person&&<a class="more" href={personPath('fr',person)}>Voir le profil de {person.data.name} ↗</a>}<div class="row" style="margin-top:4rem">{prev&&<a href={episodePath('fr',prev)}>← {prev.data.title.fr}</a>}{next&&<a href={episodePath('fr',next)}>→ {next.data.title.fr}</a>}</div></div></section></BaseLayout>
