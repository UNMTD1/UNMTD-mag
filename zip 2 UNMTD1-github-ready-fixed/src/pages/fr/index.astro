---
const BASE=import.meta.env.BASE_URL.replace(/\/$/,'');
import BaseLayout from '../../layouts/BaseLayout.astro';import Card from '../../components/Card.astro';import {getEpisodes,getSeries,getPeople,episodePath,seriesPath} from '../../utils/content';const eps=await getEpisodes(),ser=await getSeries(),people=await getPeople(),featured=eps.find(x=>x.data.featured)||eps[0];
---
<BaseLayout locale="fr" title="Women shaping music, one story at a time."><section class="hero"><div class="container inner"><div class="eyebrow">UNMTD1 / UNMUTED ONE</div><h1 class="display">Women shaping music,<br/>one story at a time.</h1><p>Une plateforme éditoriale internationale consacrée aux femmes qui créent, produisent, enregistrent et font vivre la musique.</p>{ser[0]&&<a class="button" href={seriesPath('fr',ser[0])}>Explorer la série actuelle ↗</a>}</div></section>{featured&&<section class="section"><div class="container split"><div><div class="eyebrow">THIS WEEK / PUBLICATION DE LA SEMAINE</div><h2>{featured.data.title.fr}</h2><p>{featured.data.excerpt.fr}</p><a class="more" href={episodePath('fr',featured)}>Lire l'histoire ↗</a></div><a class="feature" href={episodePath('fr',featured)}>{featured.data.image&&<img src={featured.data.image} alt={featured.data.imageAlt?.fr||''}/>}</a></div></section>}<section class="section"><div class="container"><div class="eyebrow">LATEST STORIES</div><h2>Les dernières histoires.</h2><div class="grid3">{eps.slice(0,3).map(x=><Card item={x} locale="fr" kind="episode"/>)}</div></div></section><section class="section dark"><div class="container"><div class="eyebrow">THE SERIES</div><h2>Trois femmes.<br/>Trois semaines.</h2><div class="grid3">{ser.slice(0,3).map(x=><Card item={x} locale="fr" kind="series"/>)}</div></div></section><section class="section"><div class="container"><div class="eyebrow">EXPLORE PEOPLE</div><h2>Les personnes derrière la musique.</h2><div class="grid4">{people.filter(x=>x.data.featured).map(x=><Card item={x} locale="fr" kind="person"/>)}</div></div></section><section class="section"><div class="container archive"><strong>WATCH / LISTEN / ARCHIVE</strong><a class="more" href={BASE+"/fr/archive/"}>Explorer les archives ↗</a></div></section></BaseLayout>
