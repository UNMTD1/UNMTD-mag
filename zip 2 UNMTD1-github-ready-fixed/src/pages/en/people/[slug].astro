---
import BaseLayout from '../../../layouts/BaseLayout.astro';import Card from '../../../components/Card.astro';import {getCollection} from 'astro:content';export async function getStaticPaths(){return (await getCollection('people')).map(entry=>({params:{slug:entry.id.replace(/\.md$/,'')},props:{entry}}))};const{entry}=Astro.props;const eps=await getCollection('episodes',({data})=>!data.draft&&data.person===entry.id.replace(/\.md$/,''));
---
<BaseLayout locale="en" title={entry.data.name} description={entry.data.bio.en} image={entry.data.image}><section class="container profile"><div class="portrait">{entry.data.image&&<img src={entry.data.image} alt={entry.data.imageAlt?.en||entry.data.name}/>}</div><div><div class="eyebrow">PEOPLE / PROFILE</div><h1>{entry.data.name}</h1><p><b>{entry.data.role.join(' · ')}</b>{entry.data.location&&<> · {entry.data.location}</>}</p><p class="bio">{entry.data.bio.en}</p><p class="muted">{entry.data.genres.join(' · ')}</p></div></section><section class="section"><div class="container"><h2>UNMTD1 Stories</h2><div class="grid3">{eps.map(x=><Card item={x} locale="fr" kind="episode"/>)}</div></div></section></BaseLayout>
