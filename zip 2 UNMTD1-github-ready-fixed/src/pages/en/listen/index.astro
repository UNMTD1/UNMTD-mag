---
import BaseLayout from '../../../layouts/BaseLayout.astro';import Card from '../../../components/Card.astro';import {getEpisodes} from '../../../utils/content';const items=(await getEpisodes()).filter(x=>x.data.audio);
---
<BaseLayout locale="en" title="Listen"><section class="head"><div class="container"><div class="eyebrow">LISTEN</div><h1 class="display">Listen.</h1></div></section><section class="section"><div class="container"><div class="grid3">{items.map(x=><Card item={x} locale="en" kind="episode"/>)}</div></div></section></BaseLayout>
