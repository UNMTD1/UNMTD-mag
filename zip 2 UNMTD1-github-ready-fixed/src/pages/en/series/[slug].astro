---
import BaseLayout from '../../../layouts/BaseLayout.astro';import {getCollection} from 'astro:content';import {episodePath} from '../../../utils/content';export async function getStaticPaths(){return (await getCollection('series')).map(entry=>({params:{slug:entry.id.replace(/\.md$/,'')},props:{entry}}))};const{entry}=Astro.props;const episodes=(await getCollection('episodes',({data})=>!data.draft&&data.series===entry.id.replace(/\.md$/,''))).sort((a,b)=>a.data.episode-b.data.episode);
---
<BaseLayout locale="en" title={entry.data.title.en}><section class="seriesHero"><div class="container"><div class="eyebrow">SERIES {String(entry.data.number).padStart(3,'0')} · {entry.data.theme}</div><h1 class="display">{entry.data.title.en}</h1><p>{entry.data.description.en}</p></div></section><section class="section"><div class="container"><h2>Episodes</h2><div class="rows">{episodes.map(x=><a class="row" href={episodePath('en',x)}><b>0{x.data.episode}</b><h3>{x.data.title.en}</h3><p>{x.data.excerpt.en}</p><span>↗</span></a>)}</div></div></section></BaseLayout>
