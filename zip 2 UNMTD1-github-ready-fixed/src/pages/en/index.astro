---
const BASE=import.meta.env.BASE_URL.replace(/\/$/,'');
import BaseLayout from '../../layouts/BaseLayout.astro';import Card from '../../components/Card.astro';import {getEpisodes,getSeries,getPeople,episodePath,seriesPath} from '../../utils/content';const eps=await getEpisodes(),ser=await getSeries(),people=await getPeople(),featured=eps.find(x=>x.data.featured)||eps[0];
---
<BaseLayout locale="en" title="Women shaping music, one story at a time."><section class="hero"><div class="container inner"><div class="eyebrow">UNMTD1 / UNMUTED ONE</div><h1 class="display">Women shaping music,<br/>one story at a time.</h1><p>An international editorial platform about women who create, produce, record and shape music.</p>{ser[0]&&<a class="button" href={seriesPath('en',ser[0])}>Explore current series ↗</a>}</div></section>{featured&&<section class="section"><div class="container split"><div><div class="eyebrow">THIS WEEK / WEEKLY FEATURE</div><h2>{featured.data.title.en}</h2><p>{featured.data.excerpt.en}</p><a class="more" href={episodePath('en',featured)}>Read the story ↗</a></div><a class="feature" href={episodePath('en',featured)}>{featured.data.image&&<img src={featured.data.image} alt={featured.data.imageAlt?.fr||''}/>}</a></div></section>}<section class="section"><div class="container"><div class="eyebrow">LATEST STORIES</div><h2>The latest stories.</h2><div class="grid3">{eps.slice(0,3).map(x=><Card item={x} locale="en" kind="episode"/>)}</div></div></section><section class="section dark"><div class="container"><div class="eyebrow">THE SERIES</div><h2>Three women.<br/>Three weeks.</h2><div class="grid3">{ser.slice(0,3).map(x=><Card item={x} locale="en" kind="series"/>)}</div></div></section><section class="section"><div class="container"><div class="eyebrow">EXPLORE PEOPLE</div><h2>The people behind the music.</h2><div class="grid4">{people.filter(x=>x.data.featured).map(x=><Card item={x} locale="en" kind="person"/>)}</div></div></section><section class="section"><div class="container archive"><strong>WATCH / LISTEN / ARCHIVE</strong><a class="more" href={BASE+"/en/archive/"}>Explore the archive ↗</a></div></section></BaseLayout>
