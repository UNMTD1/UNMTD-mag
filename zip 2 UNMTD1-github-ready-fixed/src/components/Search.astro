---
const {locale}=Astro.props;
---
<section class="search" data-search data-locale={locale}><input aria-label="Search" placeholder={locale==='fr'?'Rechercher…':'Search…'}/><div class="filters"><select data-f="role"><option value="">{locale==='fr'?'Tous les métiers':'All roles'}</option></select><select data-f="genre"><option value="">{locale==='fr'?'Tous les genres':'All genres'}</option></select><select data-f="series"><option value="">{locale==='fr'?'Toutes les séries':'All series'}</option></select></div><div class="results"></div></section>
<script>const root=document.querySelector('[data-search]');if(root){const input=root.querySelector('input'),results=root.querySelector('.results'),sels=[...root.querySelectorAll('select')];let items=[];const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));const render=()=>{const q=input.value.toLowerCase(),v=sels.map(x=>x.value);const f=items.filter(x=>(!q||JSON.stringify(x).toLowerCase().includes(q))&&(!v[0]||(x.roles||[]).includes(v[0]))&&(!v[1]||(x.genres||[]).includes(v[1]))&&(!v[2]||x.series===v[2])).slice(0,30);results.innerHTML=f.length?f.map(x=>`<a class="result" href="${x.url}"><small>${esc(x.kind)}</small><b>${esc(x.title)}</b><span>${esc(x.excerpt||x.series||'')}</span></a>`).join(''):`<p>No results.</p>`};fetch(import.meta.env.BASE_URL+'search-index.json').then(r=>r.json()).then(d=>{items=d;const vals=(k)=>[...new Set(d.flatMap(x=>x[k]||[]))].sort();sels.forEach((s,i)=>{const k=['roles','genres','series'][i];(k==='series'?[...new Set(d.map(x=>x.series).filter(Boolean))]:vals(k)).forEach(v=>{const o=document.createElement('option');o.value=v;o.textContent=v;s.appendChild(o)})});render()});[input,...sels].forEach(x=>x.addEventListener('input',render))}</script>
