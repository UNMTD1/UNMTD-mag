---
import {nav,type Locale} from '../data/site'; const {locale}=Astro.props; const other=locale==='fr'?'en':'fr'; const base=import.meta.env.BASE_URL.replace(/\/$/,''); const pathname=Astro.url.pathname; const relative=base && pathname.startsWith(base) ? pathname.slice(base.length) || '/' : pathname; const path=relative.replace(new RegExp(`^/${locale}`),`/${other}`)||`/${other}/`; const switchPath=base+path; const home=`${base}/${locale}/`;
---
<header><div class="nav"><a class="logo" href={home}>UNMTD<span>1</span></a><nav>{nav[locale].map(([label,href])=><a href={href}>{label}</a>)}</nav><div class="tools"><a href={switchPath}>{locale.toUpperCase()} / {other.toUpperCase()}</a><button class="menu" aria-expanded="false" aria-controls="mobile">☰</button></div></div><div id="mobile" hidden>{nav[locale].map(([label,href])=><a href={href}>{label}</a>)}</div></header>
<script>const b=document.querySelector('.menu'),m=document.querySelector('#mobile');b?.addEventListener('click',()=>{const open=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!open));if(m)m.hidden=open});</script>
